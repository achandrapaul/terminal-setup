{{- $email := promptStringOnce . "email" "Git signing email" -}}
encryption = "age"

[age]
  identity = "~/.config/chezmoi/key.txt"
  recipient = "age1r4dk8dzqp9xvndfgdnx702jzsws5k5ptuc6qdwj6p9e9m8q2kyfqafpqfm"

[edit]
  apply = true

[git]
  autoCommit = true
  autoPush = true

[hooks.re-add.pre]
  command = "{{ .chezmoi.homeDir }}/.config/bin/chezmoi-encrypt-digest"

[hooks.re-add.post]
  command = "{{ .chezmoi.homeDir }}/.config/bin/chezmoi-encrypt-digest"

[data]
  email = {{ $email | quote }}
